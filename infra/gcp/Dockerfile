# Custom container image for Dataproc Serverless.
#
# Pins Python 3.11 (= local/CI) and installs the project runtime deps minus
# pyspark/py4j — the Serverless runtime supplies Spark, and a second Spark
# wheel here would conflict with it. Built to the Serverless container
# contract: a spark user with UID/GID 1099, procps, tini, no bundled
# Spark/JRE. Built and pushed by build_image.sh; requirements.txt is
# generated there (pyspark/py4j filtered mechanically).
#
# The in-image smoke checks the deps this image owns. pyspark + SparkSession
# are validated on the cluster (the runtime provides Spark), i.e. by the
# first containerized job submit, not here.
FROM debian:12-slim

ENV DEBIAN_FRONTEND=noninteractive

# Serverless container contract: process tools + init.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       procps tini libjemalloc2 wget ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Miniforge → pinned Python 3.11. Dataproc runs this interpreter for PySpark
# via PYSPARK_PYTHON; the runtime's pure-Python pyspark/py4j ride on top.
ENV CONDA_HOME=/opt/conda
ENV PATH=${CONDA_HOME}/bin:${PATH}
ENV PYSPARK_PYTHON=${CONDA_HOME}/bin/python
RUN wget -q https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh \
       -O /tmp/miniforge.sh \
  && bash /tmp/miniforge.sh -b -p ${CONDA_HOME} \
  && rm /tmp/miniforge.sh \
  && conda install -y python=3.11 \
  && conda clean -ay

# Project runtime dependencies (pyspark/py4j excluded — generated by build_image.sh).
COPY requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt \
  && rm /tmp/requirements.txt

# Serverless contract: container runs as user spark, UID/GID 1099.
RUN groupadd -g 1099 spark \
  && useradd -u 1099 -g 1099 -d /home/spark -m spark

# Fail the build if a native extension is broken in-image. fastwarc/orjson/tldextract
# are Stage 4 native deps — import them so a broken wheel fails the build, not the executor.
RUN python -c "import pydantic_core, pydantic, structlog, yaml, fastwarc.warc, orjson, tldextract; print('image deps OK')"

# tini is installed per the Serverless contract, but Dataproc controls the
# workload command — the image must not set its own ENTRYPOINT.
USER spark
